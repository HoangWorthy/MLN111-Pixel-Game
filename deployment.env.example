# Copy this file to `.env` in the VPS deploy directory.
# Keep these values in sync with Docker build args in `.github/workflows/deploy.yaml`.
#
# For direct IP deployment:
#   CLIENT_URL=http://115.73.218.193:25577
#   NEXT_PUBLIC_SERVER_URL=http://115.73.218.193:25578
#
# For domain deployment:
#   CLIENT_URL=https://your-client-domain.example.com
#   NEXT_PUBLIC_SERVER_URL=https://your-socket-server-domain.example.com

NODE_ENV=production

# Express + Socket.IO multiplayer server port inside the container.
PORT=25578

# Next.js client port inside the container.
CLIENT_PORT=25577

# Public URL where browsers open the frontend.
# This value is used by the multiplayer server CORS allowlist.
CLIENT_URL=http://115.73.218.193:25577

# Public URL where browsers connect to the Socket.IO server.
# This must be reachable from player browsers and must not end with a slash.
# Because this is a NEXT_PUBLIC variable, use the same value at Docker build time.
NEXT_PUBLIC_SERVER_URL=http://115.73.218.193:25578
